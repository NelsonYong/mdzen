{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seren",
  "version": "0.0.1",
  "identifier": "ai.seren.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @seren/pet run build:client",
    "beforeBuildCommand": "pnpm --filter @seren/pet run build",
    "devUrl": null,
    "frontendDist": "../web"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
