{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for all Seren windows. Grants core surface + the window APIs the JS side needs (set_focus, set_position via custom drag commands, etc.).",
  "windows": ["main", "input", "history"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:webview:default"
  ]
}
